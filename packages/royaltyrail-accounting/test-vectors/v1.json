{
  "schemaVersion": 2,
  "totalShareUnits": 100000000,
  "percentageDecimalPlaces": 6,
  "vectors": [
    {
      "name": "exact-70-20-10",
      "shares": [70000000, 20000000, 10000000],
      "deposits": ["1000000"],
      "expectedAllocations": [["700000", "200000", "100000"]],
      "expectedFinalAllocated": ["700000", "200000", "100000"]
    },
    {
      "name": "six-decimal-thirds-micro-payments",
      "shares": [33333333, 33333333, 33333334],
      "deposits": ["1", "1", "1", "1", "1"],
      "expectedAllocations": [
        ["0", "0", "1"],
        ["1", "0", "0"],
        ["0", "1", "0"],
        ["0", "0", "1"],
        ["1", "0", "0"]
      ],
      "expectedFinalAllocated": ["2", "1", "2"]
    },
    {
      "name": "regression-fixed-remainder-negative-delta",
      "shares": [1, 49999999, 50000000],
      "deposits": ["50000001", "1"],
      "expectedAllocations": [
        ["1", "25000000", "25000000"],
        ["0", "0", "1"]
      ],
      "expectedFinalAllocated": ["1", "25000000", "25000001"]
    },
    {
      "name": "equal-halves-single-units",
      "shares": [50000000, 50000000],
      "deposits": ["1", "1", "1"],
      "expectedAllocations": [
        ["1", "0"],
        ["0", "1"],
        ["1", "0"]
      ],
      "expectedFinalAllocated": ["2", "1"]
    },
    {
      "name": "single-recipient",
      "shares": [100000000],
      "deposits": ["123456789"],
      "expectedAllocations": [["123456789"]],
      "expectedFinalAllocated": ["123456789"]
    }
  ]
}
